r:#e50e0e !important;display:block;font-family:"robotoregular";font-size:13px}


#header .col3 .col2 {
  margin: 10px 0 5px;
  padding: 0;
  width: 100%;
}
#header .col2 .emergency-numbers.emerge1 img.emergency-blinker {
  right: -21px;
  top: -9px;
}
.emergency-numbers.emerge1 > span {
  font-weight: 600;
  color: #333;
}
@media only screen and (max-width: 1024px) {

#header .col3 {
  float: left;
  text-align: right;
  width: auto;
  margin: 27px 0 0 25px;
}
#header .col3 .col2 {
  margin: 10px 0 5px;
  padding: 0;
  width: auto;
}


}

@media only screen and (max-width: 767px) {

#header .col2 {
  width: 56%;
}

}

@media only screen and (max-width: 480px) {
#header .col3 .col2 {
  margin: 0px 0 9px;
  padding: 0;
  width: 100%;
}
#header .col2 {
  padding: 14px 0 15px;
  text-align: center;
  width: 100%;
}
#header .col3 {
  float: left;
  margin: 0;
  text-align: right;
  width: 100%;
}
}
